# ─────────────────────────────────────────────
# Ubuntu HRMS — Playwright E2E Test Environment
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── App URLs ──────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ── Test Credentials ──────────────────────────
# Admin / Owner
TEST_ADMIN_USER=testadmin
TEST_ADMIN_PASS=testpass123

# Manager / Supervisor
TEST_MANAGER_USER=testmanager
TEST_MANAGER_PASS=testpass123

# Employee
TEST_EMPLOYEE_USER=testemployee
TEST_EMPLOYEE_PASS=testpass123

# Contractor
TEST_CONTRACTOR_USER=testcontractor
TEST_CONTRACTOR_PASS=testpass123

# Daily Labourer
TEST_LABOURER_USER=testlabourer
TEST_LABOURER_PASS=testpass123

# ── JWT ──────────────────────────────────────
# Used for compliance tests — set to a pre-signed expired token
TEST_EXPIRED_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6OTk5LCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MTYwMDAwMDAwMX0.EXPIRED_SIGNATURE

# ── Misc ─────────────────────────────────────
# Set to true to keep browser open on failure (local debugging)
PWDEBUG=0
